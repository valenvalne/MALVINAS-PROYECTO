# Django Settings
DJANGO_SECRET_KEY=malvinas-secret-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# IA LLM Engine (Anthropic Claude o compatible)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Integración Única con Google Sheets
# ID que figura en la URL de Google Sheets: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Pestañas de Google Sheets (Exactas a las acordadas en PLAN DE TRABAJO.MD)
SHEETS_TAB_TESTIMONIOS=Testimonios_Generales
SHEETS_TAB_EVENTOS=Eventos_Georreferenciados
